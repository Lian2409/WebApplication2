@{
    ViewData["Title"] = "בית הספר שלנו";
}
<div class="container mt-4">
    <h1 class="text-center mb-4">מערכת ניהול בית ספר</h1>
    <h2>תלמידים</h2>
    <table class="table table-bordered">
        <tr>
            <th>מספר תלמיד</th>
            <th>שם פרטי</th>
            <th>שם משפחה</th>
            <th>כיתה</th>
        </tr>
        @foreach (var student in ViewBag.Students)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.FirstName</td>
                <td>@student.LastName</td>
                <td>@student.GradeLevel1</td>
            </tr>
        }
    </table>
    <h2>מורים</h2>
    <table class="table table-bordered">
        <tr>
            <th>מספר מורה</th>
            <th>שם פרטי</th>
            <th>שם משפחה</th>
            <th>מקצוע</th>
        </tr>
        @foreach (var teacher in ViewBag.Teachers)
        {
            <tr>
                <td>@teacher.Id</td>
                <td>@teacher.FirstName</td>
                <td>@teacher.LastName</td>
                <td>@teacher.Subject</td>
            </tr>
        }
    </table>
    <h2>קורסים</h2>
    <table class="table table-bordered">
        <tr>
            <th>מספר קורס</th>
            <th>שם הקורס</th>
            <th>מספר מורה</th>
        </tr>
        @foreach (var course in ViewBag.Courses)
        {
            <tr>
                <td>@course.Id</td>
                <td>@course.Name</td>
                <td>@course.TeacherId</td>
            </tr>
        }
    </table>
    <h2>הרשמות לקורסים</h2>
    <table class="table table-bordered">
        <tr>
            <th>מספר הרשמה</th>
            <th>מספר תלמיד</th>
            <th>מספר קורס</th>
            <th>ציון</th>
        </tr>
        @foreach (var enrollment in ViewBag.Enrollments)
        {
            <tr>
                <td>@enrollment.Id</td>
                <td>@enrollment.StudentId</td>
                <td>@enrollment.CourseId</td>
                <td>@enrollment.Grade</td>
            </tr>
        }
    </table>
</div>